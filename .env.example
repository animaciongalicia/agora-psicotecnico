# Copiar a .env.local para desarrollo y configurar en Vercel para producción.

# Dominio canónico (sin barra final)
NEXT_PUBLIC_SITE_URL=https://agorapsicotecnico.com

# Google Analytics 4 (opcional — dejar vacío para desactivar)
NEXT_PUBLIC_GA_ID=

# Google Search Console (verificación por metatag, opcional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Vercel Analytics se activa automáticamente al desplegar en Vercel
